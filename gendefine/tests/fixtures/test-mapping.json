{
  "mapping_version": "1.0",
  "mapping_name": "test-format",
  "description": "Minimal test mapping for unit tests",
  "define_version": "2.1",
  "global_settings": {
    "language": "en",
    "default_purpose": "Tabulation",
    "annotated_crf_leaf_id": "LF.acrf",
    "oid_generation_strategy": "pattern"
  },
  "worksheets": {
    "Study": {
      "target": "study_metadata",
      "format": "attribute_value",
      "column_map": {
        "StudyName": { "maps_to": "StudyName" },
        "StudyDescription": { "maps_to": "StudyDescription" },
        "ProtocolName": { "maps_to": "ProtocolName" },
        "Language": { "maps_to": "Language" }
      }
    },
    "Datasets": {
      "target": "ItemGroupDef",
      "format": "tabular",
      "column_map": {
        "OID": { "maps_to": "_oid", "oid_source": "column" },
        "Dataset": {
          "maps_to": "Name",
          "also": ["Domain", "SASDatasetName"],
          "oid_role": "component"
        },
        "Description": { "maps_to": "Description.TranslatedText" },
        "Class": { "maps_to": "Class.Name" },
        "Structure": { "maps_to": "Structure" },
        "Purpose": { "maps_to": "Purpose" },
        "Repeating": { "maps_to": "Repeating" },
        "Reference Data": { "maps_to": "IsReferenceData" },
        "Comment": { "maps_to": "CommentOID", "oid_prefix": "COM", "optional": true },
        "IsNonStandard": { "maps_to": "IsNonStandard", "optional": true },
        "HasNoData": { "maps_to": "HasNoData", "optional": true }
      },
      "oid_pattern": "IG.{Dataset}"
    },
    "Variables": {
      "target": ["ItemDef", "ItemRef"],
      "format": "tabular",
      "column_map": {
        "Order": { "maps_to": "ItemRef.OrderNumber", "type": "integer" },
        "Dataset": { "maps_to": "_dataset_ref", "oid_role": "parent_lookup" },
        "Variable": { "maps_to": "Name", "also": "SASFieldName" },
        "Label": { "maps_to": "Description.TranslatedText" },
        "Data Type": { "maps_to": "DataType" },
        "Length": { "maps_to": "Length", "optional": true },
        "Mandatory": { "maps_to": "ItemRef.Mandatory" },
        "Codelist": { "maps_to": "CodeListRef.CodeListOID", "optional": true },
        "Origin": { "maps_to": "Origin.Type", "optional": true },
        "Method": { "maps_to": "ItemRef.MethodOID", "oid_prefix": "MT", "optional": true },
        "Role": { "maps_to": "ItemRef.Role", "optional": true },
        "Comment": { "maps_to": "CommentOID", "oid_prefix": "COM", "optional": true },
        "Developer Notes": { "ignore_for_define": true }
      },
      "oid_pattern": "IT.{Dataset}.{Variable}"
    }
  },
  "oid_patterns": {
    "ItemGroupDef": "IG.{Dataset}",
    "ItemDef": "IT.{Dataset}.{Variable}",
    "MethodDef": "MT.{ID}",
    "CommentDef": "COM.{ID}",
    "CodeList": "CL.{Codelist}",
    "leaf": "LF.{Dataset}"
  },
  "value_transforms": {
    "core_to_mandatory": {
      "type": "lookup",
      "map": { "Req": "Yes", "Exp": "No", "Perm": "No" },
      "default": "No"
    },
    "repeating_yes_no": {
      "type": "lookup",
      "map": { "Yes": "Yes", "No": "No", "true": "Yes", "false": "No" },
      "default": "No"
    },
    "order_to_int": {
      "type": "type_coercion",
      "target": "integer"
    },
    "where_clause_parse": {
      "type": "regex_parse",
      "pattern": "^(\\w+)\\s*(EQ|NE|LT|LE|GT|GE|IN|NOTIN)\\s*(.+)$",
      "output_fields": ["Variable", "Comparator", "Value"]
    }
  },
  "defaults": {
    "Purpose": "Tabulation",
    "Repeating": "No",
    "IsReferenceData": "No",
    "Mandatory": "No",
    "DefineVersion": "2.1.0"
  }
}
