{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/swhume/odmlib_examples/gendefine/intermediate_schema.json",
  "title": "gendefine Intermediate JSON",
  "description": "Schema for the intermediate JSON format produced by gendefine extract and consumed by gendefine generate.",
  "type": "object",
  "required": ["gendefine_version", "study", "metadata_version", "datasets", "variables"],
  "properties": {
    "gendefine_version": {
      "type": "string",
      "const": "1.0"
    },
    "source_mapping": {
      "type": "string"
    },
    "source_file": {
      "type": "string"
    },
    "study": {
      "$ref": "#/$defs/study"
    },
    "metadata_version": {
      "$ref": "#/$defs/metadata_version"
    },
    "standards": {
      "type": "array",
      "items": { "$ref": "#/$defs/standard" },
      "default": []
    },
    "datasets": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataset" }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    },
    "value_levels": {
      "type": "array",
      "items": { "$ref": "#/$defs/value_level" },
      "default": []
    },
    "where_clauses": {
      "type": "array",
      "items": { "$ref": "#/$defs/where_clause" },
      "default": []
    },
    "codelists": {
      "type": "array",
      "items": { "$ref": "#/$defs/codelist" },
      "default": []
    },
    "dictionaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/dictionary" },
      "default": []
    },
    "methods": {
      "type": "array",
      "items": { "$ref": "#/$defs/method" },
      "default": []
    },
    "comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/comment" },
      "default": []
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/document" },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "study": {
      "type": "object",
      "required": ["oid", "study_name", "study_description", "protocol_name"],
      "properties": {
        "oid": { "type": "string" },
        "study_name": { "type": "string" },
        "study_description": { "type": "string" },
        "protocol_name": { "type": "string" },
        "language": { "type": "string" },
        "annotated_crf": { "type": "string" }
      },
      "additionalProperties": false
    },
    "metadata_version": {
      "type": "object",
      "required": ["oid", "name", "description", "define_version"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "define_version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": ["oid", "name", "type", "version", "status"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" },
        "publishing_set": { "type": "string" },
        "comment_oid": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dataset": {
      "type": "object",
      "required": ["oid", "name", "description", "structure", "purpose", "repeating", "is_reference_data", "archive_location_id"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "structure": { "type": "string" },
        "purpose": { "type": "string" },
        "repeating": { "type": "string", "enum": ["Yes", "No"] },
        "is_reference_data": { "type": "string", "enum": ["Yes", "No"] },
        "archive_location_id": { "type": "string" },
        "class_name": { "type": "string" },
        "subclass_name": { "type": "string" },
        "comment_oid": { "type": "string" },
        "is_non_standard": { "type": "string" },
        "standard_oid": { "type": "string" },
        "has_no_data": { "type": "string" }
      },
      "additionalProperties": false
    },
    "variable": {
      "type": "object",
      "required": ["oid", "dataset", "name", "label", "data_type", "sas_field_name", "mandatory"],
      "properties": {
        "oid": { "type": "string" },
        "dataset": { "type": "string" },
        "name": { "type": "string" },
        "label": { "type": "string" },
        "data_type": { "type": "string" },
        "sas_field_name": { "type": "string" },
        "mandatory": { "type": "string", "enum": ["Yes", "No"] },
        "length": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "significant_digits": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "display_format": { "type": "string" },
        "order": { "type": "integer" },
        "key_sequence": { "type": "integer" },
        "codelist_oid": { "type": "string" },
        "valuelist_oid": { "type": "string" },
        "origin_type": { "type": "string" },
        "origin_source": { "type": "string" },
        "pages": { "type": "string" },
        "method_oid": { "type": "string" },
        "predecessor": { "type": "string" },
        "role": { "type": "string" },
        "comment_oid": { "type": "string" },
        "is_non_standard": { "type": "string" },
        "has_no_data": { "type": "string" }
      },
      "additionalProperties": false
    },
    "value_level": {
      "type": "object",
      "required": ["vl_oid", "item_oid", "dataset", "name", "data_type", "mandatory", "order", "where_clause_oid"],
      "properties": {
        "vl_oid": { "type": "string" },
        "item_oid": { "type": "string" },
        "dataset": { "type": "string" },
        "name": { "type": "string" },
        "data_type": { "type": "string" },
        "mandatory": { "type": "string", "enum": ["Yes", "No"] },
        "order": { "type": "integer" },
        "where_clause_oid": { "type": "string" },
        "sas_field_name": { "type": "string" },
        "method_oid": { "type": "string" },
        "codelist_oid": { "type": "string" },
        "origin_type": { "type": "string" },
        "origin_source": { "type": "string" },
        "pages": { "type": "string" },
        "predecessor": { "type": "string" },
        "length": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "significant_digits": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "display_format": { "type": "string" },
        "comment_oid": { "type": "string" }
      },
      "additionalProperties": false
    },
    "where_clause": {
      "type": "object",
      "required": ["oid", "range_checks"],
      "properties": {
        "oid": { "type": "string" },
        "range_checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/range_check" },
          "minItems": 1
        },
        "comment_oid": { "type": "string" }
      },
      "additionalProperties": false
    },
    "range_check": {
      "type": "object",
      "required": ["item_oid", "comparator", "check_values"],
      "properties": {
        "item_oid": { "type": "string" },
        "comparator": { "type": "string" },
        "check_values": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "codelist": {
      "type": "object",
      "required": ["oid", "name", "data_type", "terms", "has_decode"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "data_type": { "type": "string" },
        "has_decode": { "type": "boolean" },
        "terms": {
          "type": "array",
          "items": { "$ref": "#/$defs/codelist_term" }
        },
        "comment_oid": { "type": "string" },
        "is_non_standard": { "type": "string" },
        "standard_oid": { "type": "string" },
        "nci_codelist_code": { "type": "string" }
      },
      "additionalProperties": false
    },
    "codelist_term": {
      "type": "object",
      "required": ["coded_value"],
      "properties": {
        "coded_value": { "type": "string" },
        "order": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
        "nci_term_code": { "type": "string" },
        "decoded_value": { "type": "string" }
      },
      "additionalProperties": false
    },
    "dictionary": {
      "type": "object",
      "required": ["oid", "name", "data_type", "dictionary"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "data_type": { "type": "string" },
        "dictionary": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["oid", "name", "type", "description"],
      "properties": {
        "oid": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "expression_context": { "type": "string" },
        "expression_code": { "type": "string" },
        "document": { "type": "string" },
        "pages": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "comment": {
      "type": "object",
      "required": ["oid", "description"],
      "properties": {
        "oid": { "type": "string" },
        "description": { "type": "string" },
        "document": { "type": "string" },
        "pages": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "required": ["id", "title", "href"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "href": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
